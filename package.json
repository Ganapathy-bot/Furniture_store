{
  "name": "furnistore",
  "version": "1.0.0",
  "private": true,
  "description": "FurniStore - MVP furniture e-commerce platform",
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "scripts": {
    "dev": "concurrently -n client,server -c blue,green \"npm run dev -w client\" \"npm run dev -w server\"",
    "dev:client": "npm run dev -w client",
    "dev:server": "npm run dev -w server",
    "build": "npm run build -w shared && npm run build -w server && npm run build -w client",
    "lint": "npm run lint -w client && npm run lint -w server",
    "test": "npm run test -w server",
    "audit": "npm audit --audit-level=high",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "db:init": "npm run db:init -w server",
    "db:inspect": "npm run db:inspect -w server"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.62.1",
    "@typescript-eslint/parser": "^8.62.1",
    "concurrently": "^9.1.2",
    "prettier": "^3.5.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
