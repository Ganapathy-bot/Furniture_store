# Server
NODE_ENV=development
PORT=5000
API_URL=http://localhost:5000
CLIENT_URL=http://localhost:5173

# MongoDB Atlas database: furniture_shop
MONGODB_USER=furnitureshop
MONGODB_PASSWORD=your_password
MONGODB_CLUSTER=cluster0.xxxxx.mongodb.net
# Or full URI:
# MONGODB_URI=mongodb+srv://furnitureshop:password@cluster0.xxxxx.mongodb.net/furniture_shop?retryWrites=true&w=majority

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Stripe (test mode) - see docs/stripe-setup.md
STRIPE_SECRET_KEY=sk_test_your_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Email (Mailhog for local dev)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@furnistore.local

# Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880

# Auth
AUTO_VERIFY_EMAIL=true

# Default admin (created by seed script)
ADMIN_EMAIL=admin@furnistore.com
ADMIN_PASSWORD=Admin@123456
ADMIN_NAME=Store Admin

# Client (Vite)
VITE_API_URL=http://localhost:5000/api/v1
